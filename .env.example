# Copie para .env.local (ignorado pelo git) e preencha. Nunca commite valores reais.

# --- Supabase: navegador (build do Vite) ---
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<chave publishable / anon>
VITE_SUPABASE_PROJECT_ID=<id do projeto>

# --- Supabase: servidor ---
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<chave publishable / anon>
SUPABASE_PROJECT_ID=<id do projeto>
# Chave de serviço (service_role): acesso total ao banco. Só no servidor, nunca em VITE_*.
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>

# --- Sincronizações (chamadas com Authorization: Bearer <SYNC_CRON_TOKEN>) ---
SYNC_CRON_TOKEN=<segredo longo e aleatório>

# HQ Rentals
HQ_BASE_URL=
HQ_TENANT_TOKEN=
HQ_USER_TOKEN=

# ClickMassa
CLICKMASSA_BASE_URL=
CLICKMASSA_API_KEY=
CLICKMASSA_WEBHOOK_SECRET=

# Meta Ads
META_AD_ACCOUNT_ID=
META_ADS_SYSTEM_USER_TOKEN=

# Google Ads — modo direto (recomendado fora do Lovable)
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Só se a conta for acessada por uma conta gerente (MCC):
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Opcional (padrão v25):
GOOGLE_ADS_API_VERSION=

# Google Ads — gateway legado do Lovable (alternativa; ignorado se o modo direto estiver completo)
GOOGLE_ADS_API_KEY=
LOVABLE_API_KEY=

# --- Base de Conhecimento (docs/BASE_CONHECIMENTO_SETUP.md) ---
# JSON completo da chave da conta de serviço do Google, convertido em base64 (uma linha só).
GOOGLE_SERVICE_ACCOUNT_JSON=
# IDs das pastas do Drive, separados por vírgula (subpastas entram sozinhas).
DRIVE_FOLDER_IDS=
# Chave da API da Anthropic (Claude).
ANTHROPIC_API_KEY=
# Segredo para chamar /api/kb/sync de fora (Authorization: Bearer <KB_SYNC_SECRET>).
# O Vercel Cron usa o CRON_SECRET do projeto, que a rota também aceita.
KB_SYNC_SECRET=
